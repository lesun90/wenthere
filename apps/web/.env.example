# GitHub storage credentials — copy to .env (Docker) or .env.local (pnpm dev).
# Switch backends via command, not this file:
#
#   docker compose up                         → local (default)
#   STORAGE_BACKEND=github docker compose up  → github
#
#   pnpm dev                                  → local (default)
#   STORAGE_BACKEND=github pnpm dev           → github

GITHUB_TOKEN=ghp_...
GITHUB_STORAGE_REPO=owner/repo-name
GITHUB_OWNER_SECRET=some-long-secret

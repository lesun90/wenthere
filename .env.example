# Owner credentials (single-user MVP — never stored in DB)
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=changeme
OWNER_USERNAME=yourname

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret

# PostgreSQL
DATABASE_URL=postgresql://wenthere:wenthere@localhost:5432/wenthere

# MinIO / S3-compatible storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=wenthere
STORAGE_SECRET_KEY=wenthere123
STORAGE_BUCKET=photos
# Public URL the browser uses to load images directly from storage
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:9000/photos

# Public env — safe to expose to the browser
NEXT_PUBLIC_OWNER_USERNAME=yourname
